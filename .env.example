# ====================================================================
# HIIEKO System - Environment Configuration Template
# ====================================================================
# Runtime architecture: Web + Mobile -> NestJS -> Prisma -> PostgreSQL 18.
# Supabase is NOT a runtime dependency. No client or server code reads any
# SUPABASE_* / NEXT_PUBLIC_SUPABASE_* / EXPO_PUBLIC_SUPABASE_* variable.

# --------------------------------------------------------------------
# Central API (NestJS)
# --------------------------------------------------------------------
# Web   : copy to web/.env.local   as NEXT_PUBLIC_API_URL
# Mobile: copy to Mobile/.env      as EXPO_PUBLIC_API_URL
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# App Configuration
NEXT_PUBLIC_APP_NAME="HIIEKO System"
NEXT_PUBLIC_DEFAULT_LOCALE=ro-RO

# Geofence & Work Schedule Defaults
NEXT_PUBLIC_DEFAULT_GEOFENCE_RADIUS_METERS=300
NEXT_PUBLIC_WORK_START_HOUR=9
NEXT_PUBLIC_WORK_END_HOUR=18
NEXT_PUBLIC_STANDARD_REST_MINUTES=60

# --------------------------------------------------------------------
# Backend (NestJS)
# --------------------------------------------------------------------
# The authoritative list lives in backend/.env.example (DATABASE_URL,
# JWT_SECRET, JWT_EXPIRES_IN, PORT, PADDLEOCR_URL, PADDLEOCR_TOKEN,
# PADDLEOCR_TIMEOUT, CORS_ORIGIN, MAX_FILE_SIZE). Copy it to backend/.env.
# OCR runs server-side only: the Mobile/Web clients never hold an OCR
# provider credential - they call POST /api/ocr/process.

# --------------------------------------------------------------------
# Database migration (target PostgreSQL owned by the NestJS layer)
# --------------------------------------------------------------------
# Used by database/scripts/run_migration.ts and verify_migration.ts.
# The target database must be reachable from this machine.
# If a legacy Supabase dump ever still has to be imported, it is staged
# in a separate schema named `legacy` (never public.*); see the header of
# database/migrations/002_migrate_supabase_data.sql. The legacy column
# definitions for that staging step are kept in
# database/archive/supabase-migrations/full_setup.sql.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiieko