# ====================================================================
# Solar Site Management App — Environment Configuration Template
# ====================================================================

# --------------------------------------------------------------------
# Supabase — PUBLIC (browser/mobile) credentials
# --------------------------------------------------------------------
# Only these two NEXT_PUBLIC_* variables are consumed by the web client
# (web/src/lib/supabase.ts). Copy this file to web/.env.local and paste
# the real project URL + 'anon public' key. Without them the app stays
# in a safe "not configured" mode that names exactly what is missing.
NEXT_PUBLIC_SUPABASE_URL=https://aazscejjuucjupzsykku.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_X0bDZlIil22UN4V-yZt6Og_FrMgaX5U

# NOTE ON SERVICE-ROLE:
# The service-role key is ADMIN ONLY. It must NEVER be declared with a
# NEXT_PUBLIC_ prefix (it would be shipped to the browser), and it is not
# needed by any current client code. If a server-side route ever needs it,
# keep it server-only (e.g. SUPABASE_SERVICE_ROLE_KEY) and never commit it.

# App Configuration
NEXT_PUBLIC_APP_NAME="Solar Site Manager"
NEXT_PUBLIC_DEFAULT_LOCALE=ro-RO

# Geofence & Work Schedule Defaults
NEXT_PUBLIC_DEFAULT_GEOFENCE_RADIUS_METERS=300
NEXT_PUBLIC_WORK_START_HOUR=9
NEXT_PUBLIC_WORK_END_HOUR=18
NEXT_PUBLIC_STANDARD_REST_MINUTES=60

# --------------------------------------------------------------------
# ====================================================================
# Database migration (target PostgreSQL owned by the NestJS layer)
# ====================================================================
# Used by database/scripts/run_migration.ts and verify_migration.ts.
# The target database must be reachable from this machine. Legacy
# Supabase data is staged in a schema named `legacy` (see
# database/migrations/002_migrate_supabase_data.sql header).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiieko
# Mobile (Expo) — public credentials use the EXPO_PUBLIC_ prefix.
# Copy Mobile/.env.example to Mobile/.env and set the same project URL
# + 'anon public' key. Never put service-role credentials here.
# --------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://aazscejjuucjupzsykku.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_X0bDZlIil22UN4V-yZt6Og_FrMgaX5U
SUPABASE_URL=https://aazscejjuucjupzsykku.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_X0bDZlIil22UN4V-yZt6Og_FrMgaX5U
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://aazscejjuucjupzsykku.supabase.co/auth/v1/.well-known/jwks.json
