# ====================================================================
# HIIEKO Mobile (Expo) — Environment Configuration Template
# ====================================================================
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
# Copy this file to Mobile/.env and configure with your environment.

# NestJS API Base URL (REQUIRED for online mode)
EXPO_PUBLIC_API_URL=http://localhost:4000

# For production/staging:
# EXPO_PUBLIC_API_URL=https://api.hiieko.com

# --------------------------------------------------------------------
# LEGACY: Supabase configuration (will be removed after full migration)
# --------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --------------------------------------------------------------------
# Receipt/Invoice OCR (scan workflow)
# The Mobile app sends captured images to the backend API which handles
# OCR processing via self-hosted PaddleOCR service.
# No API keys are stored in the mobile app.
# --------------------------------------------------------------------
