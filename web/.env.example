# API Configuration (Primary)
# Leave this at loopback for local development. When the web app is opened from
# another device on the LAN (tablet / phone), web/src/lib/api-client.ts swaps the
# loopback host for the hostname that served the page, keeping this port
# (see HOW_TO_RUN.md -> "Run the dev stack on a tablet / phone"). Set a real
# remote URL here to pin a specific API host instead (restart `npm run web:dev`).
NEXT_PUBLIC_API_URL=http://localhost:4000
