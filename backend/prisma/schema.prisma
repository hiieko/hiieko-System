model SolarDesign {
  id                 String                @id @default(uuid())
  project_id         String
  name               String
  description        String?
  status             SolarDesignStatusEnum @default(DRAFT)
  current_version_id String?
  created_by         String?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  project           Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  current_version   SolarDesignVersion?    @relation("CurrentVersion", fields: [current_version_id], references: [id], onDelete: SetNull)
  versions          SolarDesignVersion[]   @relation("VersionDesign")
  roof_sections     SolarRoofSection[]
  layout_settings   SolarLayoutSettings?
  module_placements SolarModulePlacement[]

  @@unique([project_id, name])
  @@index([project_id])
  @@index([status])
  @@map("solar_designs")
}

model SolarDesignVersion {
  id         String                @id @default(uuid())
  design_id  String
  version    Int
  label      String?
  status     SolarDesignStatusEnum @default(DRAFT)
  snapshot   Json
  created_by String?
  created_at DateTime              @default(now())

  design       SolarDesign       @relation("VersionDesign", fields: [design_id], references: [id], onDelete: Cascade)
  current_for  SolarDesign[]     @relation("CurrentVersion")
  bom_snapshot SolarBomSnapshot?

  @@unique([design_id, version])
  @@map("solar_design_versions")
}

model SolarRoofSection {
  id            String               @id @default(uuid())
  design_id     String
  name          String
  roof_type     SolarRoofTypeEnum    @default(FLAT)
  surface_type  SolarSurfaceTypeEnum @default(ROOF)
  slope_deg     Decimal              @default(0) @db.Decimal(6, 3)
  azimuth_deg   Decimal              @default(0) @db.Decimal(6, 3)
  roof_material String?
  thickness_mm  Decimal?             @db.Decimal(10, 3)
  polygon       Json
  origin        Json
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt

  design     SolarDesign            @relation(fields: [design_id], references: [id], onDelete: Cascade)
  obstacles  SolarObstacle[]
  placements SolarModulePlacement[]

  @@index([design_id])
  @@map("solar_roof_sections")
}

model SolarObstacle {
  id                String  @id @default(uuid())
  roof_section_id   String
  name              String?
  obstacle_type     String?
  polygon           Json
  keepout_margin_mm Decimal @default(0) @db.Decimal(10, 3)

  roof_section SolarRoofSection @relation(fields: [roof_section_id], references: [id], onDelete: Cascade)

  @@index([roof_section_id])
  @@map("solar_obstacles")
}

model SolarModuleSpec {
  id           String   @id @default(uuid())
  manufacturer String
  model        String
  power_wp     Decimal? @db.Decimal(10, 3)
  length_mm    Decimal  @db.Decimal(10, 3)
  width_mm     Decimal  @db.Decimal(10, 3)
  thickness_mm Decimal? @db.Decimal(10, 3)
  weight_kg    Decimal? @db.Decimal(10, 3)
  voc          Decimal? @db.Decimal(10, 4)
  isc          Decimal? @db.Decimal(10, 4)
  vmp          Decimal? @db.Decimal(10, 4)
  imp          Decimal? @db.Decimal(10, 4)
  technology   String?
  module_type  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  layout_settings SolarLayoutSettings[]
  placements      SolarModulePlacement[]

  @@unique([manufacturer, model])
  @@map("solar_module_specs")
}

model SolarLayoutSettings {
  id                String                     @id @default(uuid())
  design_id         String                     @unique
  module_spec_id    String?
  orientation       SolarModuleOrientationEnum @default(PORTRAIT)
  edge_margin_mm    Decimal                    @default(300) @db.Decimal(10, 3)
  row_spacing_mm    Decimal                    @default(0) @db.Decimal(10, 3)
  column_spacing_mm Decimal                    @default(20) @db.Decimal(10, 3)

  design      SolarDesign      @relation(fields: [design_id], references: [id], onDelete: Cascade)
  module_spec SolarModuleSpec? @relation(fields: [module_spec_id], references: [id])

  @@map("solar_layout_settings")
}

model SolarModulePlacement {
  id              String  @id @default(uuid())
  design_id       String
  roof_section_id String
  module_spec_id  String?
  row             Int
  column          Int
  local_x         Decimal @db.Decimal(12, 4)
  local_y         Decimal @db.Decimal(12, 4)
  local_z         Decimal @default(0) @db.Decimal(12, 4)
  rotation_deg    Decimal @default(0) @db.Decimal(6, 3)
  width_mm        Decimal @db.Decimal(10, 3)
  height_mm       Decimal @db.Decimal(10, 3)

  design       SolarDesign      @relation(fields: [design_id], references: [id], onDelete: Cascade)
  roof_section SolarRoofSection @relation(fields: [roof_section_id], references: [id], onDelete: Cascade)
  module_spec  SolarModuleSpec? @relation(fields: [module_spec_id], references: [id])

  @@index([design_id])
  @@index([roof_section_id])
  @@map("solar_module_placements")
}

model SolarMountingFamily {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  products SolarProduct[]

  @@map("solar_mounting_families")
}

model SolarProduct {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  name                  String
  family_id             String?
  product_type          SolarProductTypeEnum
  unit                  String                 @default("buc")
  length_mm             Decimal?               @db.Decimal(10, 3)
  width_mm              Decimal?               @db.Decimal(10, 3)
  height_mm             Decimal?               @db.Decimal(10, 3)
  weight_kg             Decimal?               @db.Decimal(10, 3)
  alloy                 String?
  cross_section         Json?
  structural_properties Json?
  cad_ref               String?
  catalog_status        SolarCatalogStatusEnum @default(DEMO)
  material_id           String?
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  family        SolarMountingFamily?        @relation(fields: [family_id], references: [id])
  material      Material?                   @relation(fields: [material_id], references: [id], onDelete: SetNull)
  compat_source SolarProductCompatibility[] @relation("CompatSource")
  compat_target SolarProductCompatibility[] @relation("CompatTarget")
  bom_items     SolarBomItem[]

  @@index([family_id])
  @@index([product_type])
  @@index([material_id])
  @@index([catalog_status])
  @@map("solar_products")
}

model SolarProductCompatibility {
  id                    String  @id @default(uuid())
  product_id            String
  compatible_product_id String
  rule_type             String?
  notes                 String?

  product            SolarProduct @relation("CompatSource", fields: [product_id], references: [id], onDelete: Cascade)
  compatible_product SolarProduct @relation("CompatTarget", fields: [compatible_product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, compatible_product_id])
  @@map("solar_product_compatibilities")
}

model SolarBomSnapshot {
  id                String   @id @default(uuid())
  design_version_id String   @unique
  generated_at      DateTime @default(now())
  total_weight_kg   Decimal? @db.Decimal(12, 3)
  notes             String?

  design_version SolarDesignVersion @relation(fields: [design_version_id], references: [id], onDelete: Cascade)
  items          SolarBomItem[]

  @@map("solar_bom_snapshots")
}

model SolarBomItem {
  id                String               @id @default(uuid())
  bom_snapshot_id   String
  product_id        String?
  item_type         SolarBomItemTypeEnum
  code              String
  name              String
  quantity_required Decimal              @db.Decimal(14, 3)
  unit              String
  cut_length_mm     Decimal?             @db.Decimal(10, 3)
  notes             String?

  bom_snapshot SolarBomSnapshot @relation(fields: [bom_snapshot_id], references: [id], onDelete: Cascade)
  product      SolarProduct?    @relation(fields: [product_id], references: [id])

  @@index([bom_snapshot_id])
  @@map("solar_bom_items")
}
