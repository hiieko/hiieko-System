generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String      @id @default(uuid())
  name       String
  cui        String?     @unique
  address    String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  audit_logs AuditLog[]
  clients    Client[]
  document_folders DocumentFolder[]
  documents  Document[]
  projects   Project[]
  suppliers  Supplier[]
  users      User[]
  warehouses Warehouse[]

  @@map("organizations")
}

model User {
  id                  String                   @id @default(uuid())
  organization_id     String?
  email               String                   @unique
  password_hash       String?
  role                UserRoleEnum             @default(WORKER)
  is_active           Boolean                  @default(true)
  status              UserStatusEnum           @default(ACTIVE)
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  time_logs           AttendanceRecord[]
  audit_logs          AuditLog[]               @relation("AuditActor")
  daily_reports       DailyReport[]            @relation("ReportLeader")
  employee            Employee?
  approvals           ExpenseApproval[]        @relation("ExpenseApprover")
  expenses            Expense[]                @relation("ExpenseSubmitter")
  notification_prefs  NotificationPreference[]
  created_document_folders DocumentFolder[] @relation("DocumentFolderCreator")
  created_project_requirements ProjectRequirement[] @relation("ProjectRequirementCreator")
  assessed_project_requirements ProjectRequirementAssessment[] @relation("ProjectRequirementAssessor")
  created_project_requirement_catalogs ProjectRequirementCatalog[] @relation("ProjectRequirementCatalogCreator")
  created_project_requirement_catalog_versions ProjectRequirementCatalogVersion[] @relation("RequirementCatalogVersionCreator")
  published_project_requirement_catalog_versions ProjectRequirementCatalogVersion[] @relation("RequirementCatalogVersionPublisher")
  reviewed_project_requirement_catalog_adoptions ProjectRequirementCatalogAdoption[] @relation("RequirementCatalogAdoptionReviewer")
  created_project_folder_templates ProjectFolderTemplate[] @relation("ProjectFolderTemplateCreator")
  created_project_folder_template_versions ProjectFolderTemplateVersion[] @relation("ProjectFolderTemplateVersionCreator")
  published_project_folder_template_versions ProjectFolderTemplateVersion[] @relation("ProjectFolderTemplateVersionPublisher")
  applied_project_folder_template_assignments ProjectFolderTemplateAssignment[] @relation("ProjectFolderTemplateAssignmentApplier")
  notifications       Notification[]
  project_members     ProjectMember[]
  assigned_tasks      TaskAssignment[]
  team_members        TeamMember[]
  created_daily_plans DailyPlan[]              @relation("DailyPlanCreator")
  profile             UserProfile?
  reviewed_reports    DailyReport[]            @relation("ReportReviewer")
  report_approvals    DailyReportApproval[]    @relation("ReportApprover")
  report_revisions    DailyReportRevision[]    @relation("RevisionSubmitter")
  sessions            Session[]
  password_reset_tokens PasswordResetToken[]
  attendance_corrections AttendanceCorrection[] @relation("AttendanceCorrections")
  verified_tasks      Task[]                   @relation("TaskVerifiedBy")
  microsoft_identity_link MicrosoftIdentityLink?
  organization        Organization?            @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([role])
  @@index([status])
  @@map("users")
}

/// Slice 2 (SEC-004, Decision B / K-4, K-5) — the session is the revocation unit.
/// `Session.id` is embedded in the access JWT as the `sid` claim, so a single row
/// revokes an entire login (access + refresh) without a token denylist.
model Session {
  id             String         @id @default(uuid())
  user_id        String
  created_at     DateTime       @default(now())
  last_used_at   DateTime       @default(now())
  /// Absolute lifetime (7 days). No idle timeout in Slice 2.
  expires_at     DateTime
  revoked_at     DateTime?
  revoked_reason String?
  created_ip     String?
  user_agent     String?
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  refresh_tokens RefreshToken[]

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

/// Slice 2 — opaque 256-bit refresh-token rotation ledger.
/// Only the SHA-256 hex of the raw token is ever persisted; the raw value lives
/// exclusively in the httpOnly `hiieko_rt` cookie. `replaced_by_id` links a consumed
/// token to its single successor, which is what makes reuse detectable.
model RefreshToken {
  id             String        @id @default(uuid())
  session_id     String
  token_hash     String        @unique
  issued_at      DateTime      @default(now())
  expires_at     DateTime
  used_at        DateTime?
  revoked_at     DateTime?
  replaced_by_id String?       @unique
  session        Session       @relation(fields: [session_id], references: [id], onDelete: Cascade)
  replaced_by    RefreshToken? @relation("RefreshTokenRotation", fields: [replaced_by_id], references: [id])
  replaces       RefreshToken? @relation("RefreshTokenRotation")

  @@index([session_id])
  @@map("refresh_tokens")
}

/// Password recovery (Phase 3, Piece 1) — one row per issued reset link.
/// Only the SHA-256 hex of the raw token is ever persisted; the raw value is
/// single-use, sent once in the reset email, and expires 30 minutes after issue.
model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

/// Verified delegated Microsoft identity linked to one existing HIIEKO user.
/// The stable Microsoft identity key is the tenant/object-id pair, never email.
model MicrosoftIdentityLink {
  id                    String                     @id @default(uuid())
  user_id               String                     @unique
  tenant_id             String
  object_id             String
  status                MicrosoftIdentityStatusEnum @default(CONNECTED)
  linked_at             DateTime                   @default(now())
  last_authenticated_at DateTime?
  disconnected_at       DateTime?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt
  user                  User                       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_cache           MicrosoftTokenCache?

  @@unique([tenant_id, object_id])
  @@map("microsoft_identity_links")
}

/// MSAL's serialized token cache, persisted only as authenticated ciphertext.
/// The data-encryption key is wrapped by an external key-management service;
/// plaintext access/refresh tokens and cache JSON must never be stored here.
model MicrosoftTokenCache {
  identity_link_id String                @id
  ciphertext       Bytes
  wrapped_data_key Bytes
  nonce            Bytes
  auth_tag         Bytes
  key_version      String
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  identity_link    MicrosoftIdentityLink @relation(fields: [identity_link_id], references: [id], onDelete: Cascade)

  @@map("microsoft_token_caches")
}

model RateLimitBucket {
  id           String   @id @db.VarChar(512)
  window_start DateTime
  expires_at   DateTime
  count        Int
  updated_at   DateTime @default(now()) @updatedAt

  @@index([expires_at])
  @@map("rate_limit_buckets")
}

model UserProfile {
  id            String   @id @default(uuid())
  user_id       String   @unique
  full_name     String
  phone         String?
  employee_code String?
  avatar_url    String?
  language      String   @default("ro")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        UserRoleEnum     @unique
  description String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  description String?
  created_at  DateTime         @default(now())
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  role_id       String
  permission_id String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Employee {
  id          String   @id @default(uuid())
  user_id     String?  @unique
  first_name  String
  last_name   String
  cnp         String?  @unique
  position    String?
  hourly_rate Decimal? @db.Decimal(10, 2)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User?    @relation(fields: [user_id], references: [id])

  @@map("employees")
}

model Team {
  id            String        @id @default(uuid())
  name          String
  code          String        @unique
  leader_id     String?
  project_id    String?
  is_active     Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  daily_plans   DailyPlan[]
  daily_reports DailyReport[]
  members       TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  team_id   String
  user_id   String
  joined_at DateTime @default(now())
  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

model Client {
  id              String       @id @default(uuid())
  organization_id String
  name            String
  cui             String?
  contact_person  String?
  contact_email   String?
  contact_phone   String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  projects        Project[]

  @@map("clients")
}

model Project {
  id                     String              @id @default(uuid())
  organization_id        String
  client_id              String?
  name                   String
  code                   String              @unique
  address                String
  latitude               Decimal             @db.Decimal(10, 7)
  longitude              Decimal             @db.Decimal(10, 7)
  geofence_radius_meters Int                 @default(300)
  installed_capacity_mwp Decimal?            @db.Decimal(8, 3)
  project_type           ProjectTypeEnum?
  requirement_catalog_version_id String?
  requirement_catalog_adoption_id String? @unique
  status                 ProjectStatusEnum   @default(PLANNING)
  start_date             DateTime?
  target_end_date        DateTime?
  budget_total           Decimal?            @db.Decimal(14, 2)
  currency               String              @default("RON")
  is_active              Boolean             @default(true)
  created_at             DateTime            @default(now())
  updated_at             DateTime            @updatedAt
  time_logs              AttendanceRecord[]
  avize                  Aviz[]
  budgets                Budget[]
  change_orders          ChangeOrder[]
  consumptions           Consumption[]
  cost_entries           CostEntry[]
  daily_plans            DailyPlan[]
  daily_reports          DailyReport[]
  documents              Document[]
  document_folders       DocumentFolder[]
  requirements           ProjectRequirement[]
  requirement_catalog_adoptions ProjectRequirementCatalogAdoption[] @relation("ProjectRequirementCatalogAdoptions")
  current_requirement_catalog_adoption ProjectRequirementCatalogAdoption? @relation("ProjectCurrentRequirementCatalogAdoption", fields: [requirement_catalog_adoption_id], references: [id], onDelete: Restrict)
  folder_template_assignments ProjectFolderTemplateAssignment[]
  expenses               Expense[]
  inspections            Inspection[]
  issues                 Issue[]
  zones                  LocationZone[]
  project_allocations    ProjectAllocation[]
  members                ProjectMember[]
  stages                 ProjectStage[]
  client                 Client?             @relation(fields: [client_id], references: [id])
  organization           Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  requirement_catalog_version ProjectRequirementCatalogVersion? @relation(fields: [requirement_catalog_version_id], references: [id], onDelete: Restrict)
  stock_balances         StockBalance[]
  stock_movements        StockMovement[]
  tasks                  Task[]
  solar_designs          SolarDesign[]

  @@index([organization_id])
  @@index([code])
  @@index([project_type])
  @@index([requirement_catalog_version_id])
  @@map("projects")
}

model ProjectRequirement {
  id            String                       @id @default(uuid())
  project_id    String
  definition_id String
  state         ProjectRequirementStateEnum  @default(NOT_ASSESSED)
  created_by    String?
  created_at    DateTime                     @default(now())
  updated_at    DateTime                     @updatedAt

  project       Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  definition    ProjectRequirementDefinition @relation(fields: [definition_id], references: [id], onDelete: Restrict)
  creator       User?                        @relation("ProjectRequirementCreator", fields: [created_by], references: [id], onDelete: SetNull)
  assessments   ProjectRequirementAssessment[]

  @@unique([project_id, definition_id])
  @@index([project_id, state])
  @@map("project_requirements")
}

model ProjectRequirementCatalog {
  id                    String                            @id @default(uuid())
  catalog_key           String                            @unique @db.VarChar(100)
  is_active             Boolean                           @default(true)
  published_version_id  String?
  created_by            String?
  created_at            DateTime                          @default(now())
  updated_at            DateTime                          @updatedAt

  creator               User?                             @relation("ProjectRequirementCatalogCreator", fields: [created_by], references: [id], onDelete: SetNull)
  versions              ProjectRequirementCatalogVersion[] @relation("RequirementCatalogVersions")
  published_version     ProjectRequirementCatalogVersion? @relation("PublishedRequirementCatalogVersion", fields: [id, published_version_id], references: [catalog_id, id], onDelete: Restrict)

  @@unique([id, published_version_id])
  @@map("project_requirement_catalogs")
}

model ProjectRequirementCatalogVersion {
  id            String                       @id @default(uuid())
  catalog_id    String
  version       Int
  display_name  String                       @db.VarChar(160)
  created_by    String?
  published_by  String?
  published_at  DateTime?
  created_at    DateTime                     @default(now())

  catalog       ProjectRequirementCatalog    @relation("RequirementCatalogVersions", fields: [catalog_id], references: [id], onDelete: Restrict)
  creator       User?                        @relation("RequirementCatalogVersionCreator", fields: [created_by], references: [id], onDelete: SetNull)
  publisher     User?                        @relation("RequirementCatalogVersionPublisher", fields: [published_by], references: [id], onDelete: SetNull)
  published_for ProjectRequirementCatalog?   @relation("PublishedRequirementCatalogVersion")
  definitions   ProjectRequirementDefinition[]
  projects      Project[]
  folder_template_versions ProjectFolderTemplateVersion[]
  adoptions_from ProjectRequirementCatalogAdoption[] @relation("RequirementCatalogAdoptionFromVersion")
  adoptions_to ProjectRequirementCatalogAdoption[] @relation("RequirementCatalogAdoptionToVersion")

  @@unique([catalog_id, version])
  @@unique([catalog_id, id])
  @@index([catalog_id, published_at])
  @@map("project_requirement_catalog_versions")
}

model ProjectRequirementDefinition {
  id                String                            @id @default(uuid())
  catalog_version_id String
  requirement_key   String                            @db.VarChar(120)
  description       String                            @db.VarChar(500)
  is_active         Boolean                           @default(true)

  catalog_version   ProjectRequirementCatalogVersion @relation(fields: [catalog_version_id], references: [id], onDelete: Cascade)
  applicable_types  ProjectRequirementApplicability[]
  project_requirements ProjectRequirement[]
  conditional_folders ProjectFolderTemplateFolder[]

  @@unique([catalog_version_id, requirement_key])
  @@index([catalog_version_id, is_active])
  @@map("project_requirement_definitions")
}

model ProjectRequirementApplicability {
  definition_id String
  project_type  ProjectTypeEnum

  definition    ProjectRequirementDefinition @relation(fields: [definition_id], references: [id], onDelete: Cascade)

  @@id([definition_id, project_type])
  @@index([project_type])
  @@map("project_requirement_applicability")
}

model ProjectRequirementAssessment {
  id                    String                       @id @default(uuid())
  project_requirement_id String
  previous_state        ProjectRequirementStateEnum?
  new_state             ProjectRequirementStateEnum
  assessed_by           String?
  note                  String?                      @db.VarChar(1000)
  created_at            DateTime                     @default(now())

  requirement           ProjectRequirement           @relation(fields: [project_requirement_id], references: [id], onDelete: Cascade)
  assessor              User?                        @relation("ProjectRequirementAssessor", fields: [assessed_by], references: [id], onDelete: SetNull)

  @@index([project_requirement_id, created_at])
  @@map("project_requirement_assessments")
}

model ProjectRequirementCatalogAdoption {
  id                         String                       @id @default(uuid())
  project_id                 String
  from_catalog_version_id    String?
  to_catalog_version_id      String
  previous_project_type      ProjectTypeEnum?
  new_project_type           ProjectTypeEnum
  reviewed_by                String
  reason                     String                       @db.VarChar(1000)
  created_at                 DateTime                     @default(now())

  project                    Project                      @relation("ProjectRequirementCatalogAdoptions", fields: [project_id], references: [id], onDelete: Cascade)
  current_for                Project?                     @relation("ProjectCurrentRequirementCatalogAdoption")
  from_catalog_version       ProjectRequirementCatalogVersion? @relation("RequirementCatalogAdoptionFromVersion", fields: [from_catalog_version_id], references: [id], onDelete: Restrict)
  to_catalog_version         ProjectRequirementCatalogVersion @relation("RequirementCatalogAdoptionToVersion", fields: [to_catalog_version_id], references: [id], onDelete: Restrict)
  reviewer                   User                         @relation("RequirementCatalogAdoptionReviewer", fields: [reviewed_by], references: [id], onDelete: Restrict)

  @@index([project_id, created_at])
  @@map("project_requirement_catalog_adoptions")
}

model ProjectStage {
  id            String            @id @default(uuid())
  project_id    String
  name          String
  stage_order   Int               @default(1)
  status        ProjectStatusEnum @default(PLANNING)
  start_date    DateTime?
  end_date      DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  project       Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_packages WorkPackage[]

  @@unique([project_id, stage_order])
  @@map("project_stages")
}

model WorkPackage {
  id          String       @id @default(uuid())
  stage_id    String
  name        String
  code        String
  description String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  tasks       Task[]
  stage       ProjectStage @relation(fields: [stage_id], references: [id], onDelete: Cascade)

  @@map("work_packages")
}

model LocationZone {
  id          String   @id @default(uuid())
  project_id  String
  name        String
  code        String
  coordinates Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  project     Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([project_id, code])
  @@map("location_zones")
}

model ProjectMember {
  id          String       @id @default(uuid())
  project_id  String
  user_id     String
  role        UserRoleEnum
  assigned_at DateTime     @default(now())
  project     Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@map("project_members")
}

model Task {
  id                 String            @id @default(uuid())
  project_id         String
  work_package_id    String?
  zone_id            String?
  title              String
  code               String
  description        String?
  status             TaskStatusEnum    @default(PLANNED)
  planned_start      DateTime?
  planned_end        DateTime?
  actual_start       DateTime?
  actual_end         DateTime?
  planned_quantity   Decimal?          @db.Decimal(12, 3)
  actual_quantity    Decimal?          @db.Decimal(12, 3)
  unit_of_measure    String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  daily_plan_tasks   DailyPlanTask[]
  verified_by_user   User?            @relation("TaskVerifiedBy", fields: [verified_by], references: [id])
  verified_by        String?
  is_archived        Boolean           @default(false)
  verified_at        DateTime?
  blocked_reason     String?
  blocked_at         DateTime?
  daily_report_tasks DailyReportTask[]
  assignments        TaskAssignment[]
  dependents         TaskDependency[]  @relation("PredecessorTask")
  prerequisites      TaskDependency[]  @relation("DependentOn")
  project            Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  work_package       WorkPackage?      @relation(fields: [work_package_id], references: [id])
  zone               LocationZone?     @relation(fields: [zone_id], references: [id])

  @@unique([project_id, code])
  @@index([verified_by])
  @@index([project_id, is_archived])
  @@map("tasks")
}

model TaskDependency {
  id                  String             @id @default(uuid())
  predecessor_task_id String
  successor_task_id   String
  dependency_type     DependencyTypeEnum @default(FINISH_TO_START)
  lag_days            Int                @default(0)
  predecessor         Task               @relation("PredecessorTask", fields: [predecessor_task_id], references: [id], onDelete: Cascade)
  successor           Task               @relation("DependentOn", fields: [successor_task_id], references: [id], onDelete: Cascade)

  @@unique([predecessor_task_id, successor_task_id])
  @@map("task_dependencies")
}

model TaskAssignment {
  id          String   @id @default(uuid())
  task_id     String
  user_id     String
  assigned_at DateTime @default(now())
  task        Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@map("task_assignments")
}

model AttendanceRecord {
  id                  String               @id @default(uuid())
  user_id             String
  project_id          String
  date                DateTime             @db.Date
  check_in_time       DateTime
  check_out_time      DateTime?
  status              AttendanceStatusEnum @default(PRESENT)
  check_in_latitude   Decimal?             @db.Decimal(10, 7)
  check_in_longitude  Decimal?             @db.Decimal(10, 7)
  check_in_distance_m Decimal?             @db.Decimal(8, 2)
  is_within_geofence  Boolean              @default(true)
  check_out_latitude  Decimal?             @db.Decimal(10, 7)
  check_out_longitude Decimal?             @db.Decimal(10, 7)
  regular_hours       Decimal              @default(0) @db.Decimal(5, 2)
  overtime_minutes    Int                  @default(0)
  is_offline_sync     Boolean              @default(false)
  idempotency_key     String?              @unique
  notes               String?
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  project             Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  corrections         AttendanceCorrection[]

  @@index([user_id, date])
  @@index([project_id, date])
  @@map("attendance_records")
}

/// Slice 5 — attendance correction audit ledger. Each row captures one authorized
/// correction of an AttendanceRecord, storing before/after snapshots plus the
/// mandatory human-readable reason. The FK to AttendanceRecord is `Restrict`
/// (Slice 5): a record that has been corrected can never be silently deleted,
/// preserving the audit trail. The `@@index([attendance_id])` keeps the
/// per-record correction history lookup cheap.
model AttendanceCorrection {
  id            String   @id @default(uuid())
  attendance_id String
  corrected_by   String
  reason         String
  before_state   Json
  after_state    Json
  created_at    DateTime @default(now())

  attendance AttendanceRecord @relation(fields: [attendance_id], references: [id], onDelete: Restrict)
  actor      User             @relation("AttendanceCorrections", fields: [corrected_by], references: [id])

  @@index([attendance_id])
  @@map("attendance_corrections")
}

model DailyPlan {
  id         String              @id @default(uuid())
  project_id String
  team_id    String?
  plan_date  DateTime            @db.Date
  status     DailyPlanStatusEnum @default(DRAFT)
  notes      String?
  created_by String?
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt
  tasks      DailyPlanTask[]
  project    Project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  team       Team?               @relation(fields: [team_id], references: [id])
  creator    User?               @relation("DailyPlanCreator", fields: [created_by], references: [id], onDelete: SetNull)

  @@unique([project_id, plan_date, team_id])
  @@map("daily_plans")
}

model DailyPlanTask {
  id              String    @id @default(uuid())
  daily_plan_id   String
  task_id         String
  target_quantity Decimal   @db.Decimal(12, 3)
  actual_quantity Decimal?  @db.Decimal(12, 3)
  completed       Boolean   @default(false)
  daily_plan      DailyPlan @relation(fields: [daily_plan_id], references: [id], onDelete: Cascade)
  task            Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([daily_plan_id, task_id])
  @@map("daily_plan_tasks")
}

model DailyReport {
  id              String                @id @default(uuid())
  project_id      String
  team_id         String?
  team_leader_id  String
  report_date     DateTime              @db.Date
  start_time      String?               // HH:mm (nullable — draft may be incomplete)
  end_time        String?               // HH:mm (nullable — draft may be incomplete)
  weather_notes   String?
  blockages       String?
  proposed_work   String?               // "Proposed Work" (Lucrari Propuse) - ISSUE-048: distinct from general_notes (execution notes)
  general_notes   String?
  status          String                @default("SUBMITTED")
  idempotency_key String?               @unique
  reviewed_by     String?
  reviewed_at     DateTime?
  revision_number Int                   @default(1)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  materials       DailyReportMaterial[]
  tasks           DailyReportTask[]
  workers         DailyReportWorker[]
  ohs_items       DailyReportOhsItem[]
  project         Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  team            Team?                 @relation(fields: [team_id], references: [id])
  team_leader     User                  @relation("ReportLeader", fields: [team_leader_id], references: [id], onDelete: Cascade)
  reviewer        User?                 @relation("ReportReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  approvals       DailyReportApproval[]
  revisions       DailyReportRevision[]
  production      ProductionEntry[]

  @@index([project_id, report_date])
  @@map("daily_reports")
}

model DailyReportApproval {
  id              String      @id @default(uuid())
  daily_report_id String
  reviewer_id     String
  action          String      // APPROVED | REJECTED | CANCELLED
  comment         String?
  created_at      DateTime    @default(now())
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)
  reviewer        User        @relation("ReportApprover", fields: [reviewer_id], references: [id], onDelete: Restrict)

  @@index([daily_report_id])
  @@map("daily_report_approvals")
}

model DailyReportRevision {
  id              String      @id @default(uuid())
  daily_report_id String
  revision_number Int
  snapshot        Json
  submitted_by_id String
  submitted_at    DateTime    @default(now())
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)
  submitted_by    User        @relation("RevisionSubmitter", fields: [submitted_by_id], references: [id], onDelete: Restrict)

  @@unique([daily_report_id, revision_number])
  @@map("daily_report_revisions")
}

model DailyReportWorker {
  id              String      @id @default(uuid())
  daily_report_id String
  worker_id       String
  hours_worked    Decimal     @db.Decimal(5, 2)
  overtime_hours  Decimal     @default(0) @db.Decimal(5, 2)
  notes           String?
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)

  @@map("daily_report_workers")
}

model DailyReportTask {
  id              String      @id @default(uuid())
  daily_report_id String
  task_id         String
  quantity_done   Decimal     @db.Decimal(12, 3)
  notes           String?
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)
  task            Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("daily_report_tasks")
}

model DailyReportMaterial {
  id              String      @id @default(uuid())
  daily_report_id String
  material_id     String
  quantity_used   Decimal     @db.Decimal(12, 3)
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)
  material        Material    @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@map("daily_report_materials")
}

model ProductionEntry {
  id              String      @id @default(uuid())
  daily_report_id String
  metric_name     String
  quantity        Decimal     @db.Decimal(12, 3)
  unit            String
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)

  @@map("production_entries")
}

// HIIEKO — controlled OHS/SSM risk checklist categories (P4.3.1).
// Values are enforced at the database level so risk_type is never free text.
enum OhsRiskType {
  ppe
  adverse_weather
  procedures
  electrical
  tools_machinery
  fall_height
  other_risks
}

model DailyReportOhsItem {
  id              String      @id @default(uuid())
  daily_report_id String
  risk_type       OhsRiskType
  notes           String?
  daily_report    DailyReport @relation(fields: [daily_report_id], references: [id], onDelete: Cascade)

  @@map("daily_report_ohs_items")
}

model Material {
  id                   String                @id @default(uuid())
  code                 String                @unique
  name                 String
  unit                 String
  category             String?
  barcode              String?
  qr_code              String?
  min_stock_threshold  Decimal               @default(0) @db.Decimal(12, 3)
  unit_cost_estimate   Decimal?              @db.Decimal(12, 2)
  is_active            Boolean               @default(true)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  aviz_items           AvizItem[]
  consumptions         Consumption[]
  report_materials     DailyReportMaterial[]
  lots                 MaterialLot[]
  project_allocations  ProjectAllocation[]
  purchase_order_items PurchaseOrderItem[]
  stock_balances       StockBalance[]
  stock_movements      StockMovement[]
  solar_products       SolarProduct[]

  @@map("materials")
}

model MaterialLot {
  id              String          @id @default(uuid())
  material_id     String
  lot_number      String
  expiry_date     DateTime?
  created_at      DateTime        @default(now())
  material        Material        @relation(fields: [material_id], references: [id], onDelete: Cascade)
  stock_movements StockMovement[]

  @@unique([material_id, lot_number])
  @@map("material_lots")
}

model Warehouse {
  id              String          @id @default(uuid())
  organization_id String
  name            String
  code            String          @unique
  address         String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  stock_balances  StockBalance[]
  stock_movements StockMovement[]
  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("warehouses")
}

model StockBalance {
  id                String     @id @default(uuid())
  material_id       String
  project_id        String?
  warehouse_id      String?
  current_quantity  Decimal    @default(0) @db.Decimal(12, 3)
  reserved_quantity Decimal    @default(0) @db.Decimal(12, 3)
  updated_at        DateTime   @updatedAt
  material          Material   @relation(fields: [material_id], references: [id], onDelete: Cascade)
  project           Project?   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  warehouse         Warehouse? @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([material_id, project_id, warehouse_id])
  @@index([project_id])
  @@map("stock_balances")
}

model StockMovement {
  id              String                @id @default(uuid())
  material_id     String
  lot_id          String?
  project_id      String?
  warehouse_id    String?
  movement_type   StockMovementTypeEnum
  quantity        Decimal               @db.Decimal(12, 3)
  reference_type  String?
  reference_id    String?
  idempotency_key String?               @unique
  created_by_id   String?
  notes           String?
  created_at      DateTime              @default(now())
  lot             MaterialLot?          @relation(fields: [lot_id], references: [id])
  material        Material              @relation(fields: [material_id], references: [id], onDelete: Cascade)
  project         Project?              @relation(fields: [project_id], references: [id])
  warehouse       Warehouse?            @relation(fields: [warehouse_id], references: [id])

  @@index([material_id, created_at])
  @@index([project_id, created_at])
  @@map("stock_movements")
}

model ProjectAllocation {
  id            String   @id @default(uuid())
  project_id    String
  material_id   String
  allocated_qty Decimal  @db.Decimal(12, 3)
  created_at    DateTime @default(now())
  material      Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, material_id])
  @@map("project_allocations")
}

model Consumption {
  id           String   @id @default(uuid())
  project_id   String
  material_id  String
  consumed_qty Decimal  @db.Decimal(12, 3)
  consumed_at  DateTime @default(now())
  material     Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("consumptions")
}

model Supplier {
  id              String          @id @default(uuid())
  organization_id String
  name            String
  cui             String?         @unique
  address         String?
  contact_person  String?
  contact_email   String?
  contact_phone   String?
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  avize           Aviz[]
  invoices        Invoice[]
  purchase_orders PurchaseOrder[]
  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  supplier_id  String
  order_number String              @unique
  total_amount Decimal             @db.Decimal(14, 2)
  currency     String              @default("RON")
  status       String              @default("DRAFT")
  order_date   DateTime            @default(now())
  deliveries   Delivery[]
  items        PurchaseOrderItem[]
  supplier     Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid())
  purchase_order_id String
  material_id       String
  quantity          Decimal       @db.Decimal(12, 3)
  unit_price        Decimal       @db.Decimal(12, 2)
  material          Material      @relation(fields: [material_id], references: [id], onDelete: Cascade)
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model Delivery {
  id                String         @id @default(uuid())
  purchase_order_id String?
  delivery_number   String
  delivery_date     DateTime       @default(now())
  purchase_order    PurchaseOrder? @relation(fields: [purchase_order_id], references: [id])

  @@map("deliveries")
}

model Invoice {
  id          String        @id @default(uuid())
  supplier_id String?
  number      String
  issue_date  DateTime      @db.Date
  due_date    DateTime?     @db.Date
  total_net   Decimal       @db.Decimal(14, 2)
  vat_amount  Decimal       @db.Decimal(14, 2)
  total_gross Decimal       @db.Decimal(14, 2)
  currency    String        @default("RON")
  lines       InvoiceLine[]
  supplier    Supplier?     @relation(fields: [supplier_id], references: [id])

  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoice_id  String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit_price  Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Receipt {
  id     String   @id @default(uuid())
  number String
  date   DateTime @db.Date
  total  Decimal  @db.Decimal(12, 2)

  @@map("receipts")
}

model Aviz {
  id              String         @id @default(uuid())
  project_id      String
  supplier_id     String?
  aviz_number     String
  delivery_date   DateTime       @db.Date
  status          AvizStatusEnum @default(PENDING)
  driver_name     String?
  vehicle_plate   String?
  notes           String?
  idempotency_key String?        @unique
  created_at      DateTime       @default(now())
  items           AvizItem[]
  project         Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  supplier        Supplier?      @relation(fields: [supplier_id], references: [id])

  @@unique([project_id, aviz_number])
  @@map("avize")
}

model AvizItem {
  id          String   @id @default(uuid())
  aviz_id     String
  material_id String
  quantity    Decimal  @db.Decimal(12, 3)
  aviz        Aviz     @relation(fields: [aviz_id], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@index([aviz_id])
  @@map("aviz_items")
}

model Expense {
  id              String              @id @default(uuid())
  project_id      String?
  submitted_by_id String
  category        ExpenseCategoryEnum
  payment_method  PaymentMethodEnum   @default(COMPANY_CARD)
  amount          Decimal             @db.Decimal(12, 2)
  vat_amount      Decimal?            @db.Decimal(12, 2)
  currency        String              @default("RON")
  expense_date    DateTime            @db.Date
  merchant_name   String?
  merchant_cui    String?
  document_number String?
  description     String?
  status          ExpenseStatusEnum   @default(SUBMITTED)
  idempotency_key String?             @unique
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  approvals       ExpenseApproval[]
  lines           ExpenseLine[]
  project         Project?            @relation(fields: [project_id], references: [id])
  submitted_by    User                @relation("ExpenseSubmitter", fields: [submitted_by_id], references: [id], onDelete: Cascade)
  ocr_jobs        OCRJob[]
  reimbursements  Reimbursement[]

  @@index([submitted_by_id, status])
  @@map("expenses")
}

model ExpenseLine {
  id          String   @id @default(uuid())
  expense_id  String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  vat_rate    Decimal? @db.Decimal(5, 2)
  expense     Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@map("expense_lines")
}

model ExpenseApproval {
  id          String   @id @default(uuid())
  expense_id  String
  approver_id String
  status      String
  notes       String?
  created_at  DateTime @default(now())
  approver    User     @relation("ExpenseApprover", fields: [approver_id], references: [id], onDelete: Cascade)
  expense     Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@map("expense_approvals")
}

model Reimbursement {
  id           String   @id @default(uuid())
  expense_id   String
  amount       Decimal  @db.Decimal(12, 2)
  payment_ref  String?
  processed_at DateTime @default(now())
  expense      Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)

  @@map("reimbursements")
}

model Document {
  id              String            @id @default(uuid())
  project_id      String?
  organization_id String?
  folder_id       String?
  document_type   DocumentTypeEnum
  title           String
  code            String?
  storage_path    String
  current_version Int               @default(1)
  is_archived     Boolean           @default(false)
  archived_at     DateTime?
  archived_by     String?
  restored_at     DateTime?
  restored_by     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  versions        DocumentVersion[]
  project         Project?          @relation(fields: [project_id], references: [id])
  organization    Organization?     @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  folder          DocumentFolder?   @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  ocr_jobs        OCRJob[]

  @@index([folder_id, is_archived, updated_at])
  @@index([organization_id, folder_id, is_archived, updated_at])
  @@index([is_archived, updated_at])
  @@map("documents")
}

model DocumentFolder {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(120)
  parent_id       String?
  organization_id String
  project_id      String?
  created_by      String?
  template_folder_key String?  @db.VarChar(120)
  source_template_version_id String?
  protection_policy ProjectFolderProtectionPolicyEnum @default(STANDARD)
  allow_custom_children Boolean @default(true)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [project_id], references: [id], onDelete: Restrict)
  creator         User?            @relation("DocumentFolderCreator", fields: [created_by], references: [id], onDelete: SetNull)
  parent          DocumentFolder?  @relation("DocumentFolderTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children        DocumentFolder[] @relation("DocumentFolderTree")
  documents       Document[]
  source_template_version ProjectFolderTemplateVersion? @relation(fields: [source_template_version_id], references: [id], onDelete: Restrict)

  @@index([organization_id, project_id, parent_id, name])
  @@index([organization_id, parent_id])
  @@index([source_template_version_id])
  @@map("document_folders")
}

model ProjectFolderTemplate {
  id                    String                         @id @default(uuid())
  template_key          String                         @unique @db.VarChar(100)
  kind                  ProjectFolderTemplateKindEnum
  is_active             Boolean                        @default(true)
  published_version_id  String?
  created_by            String?
  created_at            DateTime                       @default(now())
  updated_at            DateTime                       @updatedAt

  creator               User?                          @relation("ProjectFolderTemplateCreator", fields: [created_by], references: [id], onDelete: SetNull)
  versions              ProjectFolderTemplateVersion[] @relation("ProjectFolderTemplateVersions")
  published_version     ProjectFolderTemplateVersion?  @relation("ProjectFolderTemplatePublishedVersion", fields: [id, published_version_id], references: [template_id, id], onDelete: Restrict)

  @@unique([id, published_version_id])
  @@index([kind, is_active])
  @@map("project_folder_templates")
}

model ProjectFolderTemplateVersion {
  id            String                       @id @default(uuid())
  template_id   String
  version       Int
  display_name  String                       @db.VarChar(160)
  requirement_catalog_version_id String
  created_by    String?
  published_by  String?
  published_at  DateTime?
  created_at    DateTime                     @default(now())

  template      ProjectFolderTemplate        @relation("ProjectFolderTemplateVersions", fields: [template_id], references: [id], onDelete: Restrict)
  requirement_catalog_version ProjectRequirementCatalogVersion @relation(fields: [requirement_catalog_version_id], references: [id], onDelete: Restrict)
  creator       User?                        @relation("ProjectFolderTemplateVersionCreator", fields: [created_by], references: [id], onDelete: SetNull)
  publisher     User?                        @relation("ProjectFolderTemplateVersionPublisher", fields: [published_by], references: [id], onDelete: SetNull)
  folder_definitions ProjectFolderTemplateFolder[]
  applicable_types ProjectFolderTemplateVersionApplicability[]
  conflicts_as_source ProjectFolderTemplateVersionConflict[] @relation("TemplateConflictSourceVersion")
  conflicts_as_target ProjectFolderTemplateVersionConflict[] @relation("TemplateConflictTargetVersion")
  assignments   ProjectFolderTemplateAssignment[]
  published_for ProjectFolderTemplate?       @relation("ProjectFolderTemplatePublishedVersion")
  project_folders DocumentFolder[]

  @@unique([template_id, version])
  @@unique([template_id, id])
  @@index([template_id, published_at])
  @@index([requirement_catalog_version_id])
  @@map("project_folder_template_versions")
}

model ProjectFolderTemplateVersionApplicability {
  template_version_id String
  project_type        ProjectTypeEnum

  template_version ProjectFolderTemplateVersion @relation(fields: [template_version_id], references: [id], onDelete: Cascade)

  @@id([template_version_id, project_type])
  @@map("project_folder_template_version_applicability")
}

model ProjectFolderTemplateFolder {
  id                String                               @id @default(uuid())
  template_version_id String
  folder_key        String                               @db.VarChar(120)
  display_name      String                               @db.VarChar(120)
  parent_folder_key String?                              @db.VarChar(120)
  sort_order        Int                                  @default(0)
  requirement       ProjectFolderRequirementEnum         @default(OPTIONAL)
  condition_definition_id String?
  is_active         Boolean                              @default(true)
  protection_policy ProjectFolderProtectionPolicyEnum   @default(STANDARD)
  allow_custom_children Boolean                          @default(false)
  create_by_default Boolean                              @default(false)

  template_version  ProjectFolderTemplateVersion         @relation(fields: [template_version_id], references: [id], onDelete: Cascade)
  applicable_types  ProjectFolderTemplateFolderApplicability[]
  condition         ProjectRequirementDefinition?        @relation(fields: [condition_definition_id], references: [id], onDelete: Restrict)

  @@unique([template_version_id, folder_key])
  @@index([template_version_id, parent_folder_key, sort_order])
  @@index([condition_definition_id])
  @@map("project_folder_template_folders")
}

model ProjectFolderTemplateFolderApplicability {
  folder_definition_id String
  project_type         ProjectTypeEnum

  folder_definition    ProjectFolderTemplateFolder @relation(fields: [folder_definition_id], references: [id], onDelete: Cascade)

  @@id([folder_definition_id, project_type])
  @@index([project_type])
  @@map("project_folder_template_folder_applicability")
}

model ProjectFolderTemplateAssignment {
  id               String                       @id @default(uuid())
  project_id       String
  template_id      String
  template_version Int
  component_kind   ProjectFolderTemplateKindEnum
  applied_at       DateTime                     @default(now())
  superseded_at    DateTime?
  applied_by       String?

  project          Project                      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  template_version_record ProjectFolderTemplateVersion @relation(fields: [template_id, template_version], references: [template_id, version], onDelete: Restrict)
  applier          User?                        @relation("ProjectFolderTemplateAssignmentApplier", fields: [applied_by], references: [id], onDelete: SetNull)

  @@index([project_id, superseded_at])
  @@index([project_id, template_id, superseded_at])
  @@index([project_id, component_kind])
  @@map("project_folder_template_assignments")
}

model ProjectFolderTemplateVersionConflict {
  template_version_id             String
  incompatible_template_version_id String

  source_version       ProjectFolderTemplateVersion @relation("TemplateConflictSourceVersion", fields: [template_version_id], references: [id], onDelete: Cascade)
  incompatible_version ProjectFolderTemplateVersion @relation("TemplateConflictTargetVersion", fields: [incompatible_template_version_id], references: [id], onDelete: Cascade)

  @@id([template_version_id, incompatible_template_version_id])
  @@index([incompatible_template_version_id])
  @@map("project_folder_template_version_conflicts")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  document_id  String
  version      Int
  storage_path String
  file_size    Int
  checksum     String?
  uploaded_by  String?
  created_at   DateTime @default(now())
  document     Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, version])
  @@index([checksum, document_id], map: "document_versions_checksum_document_idx")
  @@map("document_versions")
}

model OCRJob {
  id             String          @id @default(uuid())
  document_id    String?
  expense_id     String?
  provider       String          @default("PADDLE_OCR")
  state          OCRJobStateEnum @default(PENDING)
  correlation_id String?         @unique
  raw_payload    Json?
  error_message  String?
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  extractions    OCRExtraction[]
  document       Document?       @relation(fields: [document_id], references: [id])
  expense        Expense?        @relation(fields: [expense_id], references: [id])

  @@map("ocr_jobs")
}

model OCRExtraction {
  id             String  @id @default(uuid())
  ocr_job_id     String
  field_name     String
  raw_value      String?
  normalized_val String?
  confidence     Decimal @db.Decimal(5, 4)
  is_reviewed    Boolean @default(false)
  ocr_job        OCRJob  @relation(fields: [ocr_job_id], references: [id], onDelete: Cascade)

  @@map("ocr_extractions")
}

model InspectionTemplate {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  checklist   Json
  created_at  DateTime     @default(now())
  inspections Inspection[]

  @@map("inspection_templates")
}

model Inspection {
  id             String              @id @default(uuid())
  project_id     String
  template_id    String?
  inspector_name String
  status         String              @default("PENDING")
  inspected_at   DateTime            @default(now())
  project        Project             @relation(fields: [project_id], references: [id], onDelete: Cascade)
  template       InspectionTemplate? @relation(fields: [template_id], references: [id])
  measurements   Measurement[]
  ncrs           NCR[]

  @@map("inspections")
}

model Measurement {
  id            String     @id @default(uuid())
  inspection_id String
  parameter     String
  value         Decimal    @db.Decimal(12, 4)
  unit          String
  passed        Boolean    @default(true)
  inspection    Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Issue {
  id          String            @id @default(uuid())
  project_id  String
  title       String
  description String
  severity    IssueSeverityEnum @default(MEDIUM)
  status      IssueStatusEnum   @default(OPEN)
  reported_by String?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  project     Project           @relation(fields: [project_id], references: [id], onDelete: Cascade)
  ncrs        NCR[]

  @@map("issues")
}

model NCR {
  id            String        @id @default(uuid())
  issue_id      String?
  inspection_id String?
  ncr_number    String        @unique
  description   String
  status        NCRStatusEnum @default(OPEN)
  created_at    DateTime      @default(now())
  inspection    Inspection?   @relation(fields: [inspection_id], references: [id])
  issue         Issue?        @relation(fields: [issue_id], references: [id])

  @@map("ncrs")
}

model ChangeOrder {
  id              String                @id @default(uuid())
  project_id      String
  order_number    String                @unique
  title           String
  description     String
  cost_impact     Decimal               @default(0) @db.Decimal(14, 2)
  schedule_impact Int                   @default(0)
  status          ChangeOrderStatusEnum @default(DRAFT)
  version         Int                   @default(1)
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  project         Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("change_orders")
}

model Budget {
  id          String       @id @default(uuid())
  project_id  String
  version     Int          @default(1)
  total_limit Decimal      @db.Decimal(14, 2)
  created_at  DateTime     @default(now())
  lines       BudgetLine[]
  project     Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, version])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(uuid())
  budget_id String
  category  String
  allocated Decimal @db.Decimal(14, 2)
  budget    Budget  @relation(fields: [budget_id], references: [id], onDelete: Cascade)

  @@map("budget_lines")
}

model CostEntry {
  id         String   @id @default(uuid())
  project_id String
  category   String
  amount     Decimal  @db.Decimal(14, 2)
  entry_date DateTime @db.Date
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("cost_entries")
}

model Commitment {
  id          String  @id @default(uuid())
  description String
  amount      Decimal @db.Decimal(14, 2)
  status      String  @default("ACTIVE")

  @@map("commitments")
}

model Payment {
  id      String   @id @default(uuid())
  amount  Decimal  @db.Decimal(14, 2)
  method  String
  paid_at DateTime @default(now())

  @@map("payments")
}

model Notification {
  id         String                   @id @default(uuid())
  user_id    String
  title_ro   String
  title_en   String?
  message_ro String
  message_en String?
  priority   NotificationPriorityEnum @default(NORMAL)
  action_url String?
  metadata   Json?
  is_read    Boolean                  @default(false)
  read_at    DateTime?
  created_at DateTime                 @default(now())
  user       User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model NotificationPreference {
  id         String                  @id @default(uuid())
  user_id    String
  category   String
  channel    NotificationChannelEnum
  is_enabled Boolean                 @default(true)
  user       User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category, channel])
  @@map("notification_preferences")
}

model Attachment {
  id          String   @id @default(uuid())
  target_type String
  target_id   String
  file_name   String
  storage_url String
  mime_type   String?
  created_at  DateTime @default(now())

  @@index([target_type, target_id])
  @@map("attachments")
}

model AuditLog {
  id              String        @id @default(uuid())
  organization_id String?
  actor_id        String?
  action          String
  entity          String
  entity_id       String
  before_state    Json?
  after_state     Json?
  metadata        Json?
  ip_address      String?
  user_agent      String?
  created_at      DateTime      @default(now())
  actor           User?         @relation("AuditActor", fields: [actor_id], references: [id])
  organization    Organization? @relation(fields: [organization_id], references: [id])

  @@index([entity, entity_id])
  @@index([actor_id])
  @@index([created_at])
  @@map("audit_logs")
}

