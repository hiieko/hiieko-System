# Backend Environment Configuration

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hiieko_solar?schema=public"

# JWT Configuration
# REQUIRED (SEC-002) — the backend refuses to start when this is unset; there is no hardcoded
# fallback. Use a long, random value in every environment.
JWT_SECRET=""
# Slice 1 keeps the current 7-day access-token baseline. The 15-minute TTL and refresh tokens
# are introduced in Slice 2.
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Company day boundary (Slice 3)
# Canonical IANA timezone for every business calendar day ("today"): attendance
# check-in/check-out, attendance today-summary, daily-plan defaults and the
# date-only @db.Date encodings. Blank/missing falls back to Europe/Bucharest.
COMPANY_TZ="Europe/Bucharest"

# PaddleOCR Service Configuration
# Base URL of the self-hosted ocr-service (ocr-service/README.md). It listens on
# 127.0.0.1:8080 by default (`uvicorn app.main:app --port 8080`); the backend
# appends `/v1/ocr/document` and `/health`.
PADDLEOCR_URL="http://localhost:8080"
# Must equal the ocr-service OCR_SERVICE_TOKEN. The backend sends it as
# `Authorization: Bearer <token>`. Leave empty to keep OCR disabled.
PADDLEOCR_TOKEN="change-this-local-token"
PADDLEOCR_TIMEOUT=60000

# Demo mode (public GET /api/demo/accounts)
# The endpoint is inert when NODE_ENV=production unless this is set to "true". It only
# reports which seeded demo accounts exist and have data — never passwords.
DEMO_MODE="false"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:19006"
# For LAN development (phone/tablet on same Wi-Fi):
# CORS_ORIGIN=http://localhost:3000,http://localhost:19006,http://<YOUR_LAN_IP>:3000

# File Upload Limits
MAX_FILE_SIZE=10485760

# Email (Phase 3 Piece 1 — password reset; provider: Resend)
# RESEND_API_KEY="re_..."              # add your real key in backend/.env, NOT here
RESEND_FROM="HIIEKO <noreply@hiieko.app>"
# Public origin used to build the reset link. In production this is the Netlify URL.
PUBLIC_APP_URL="http://localhost:3000"

# Blob Storage (ISSUE-013 — receipt/document binaries; abstracted via StorageService)
# "local" (default) writes under STORAGE_ROOT on the server — fine for
# development/demo; files live and die with the host disk.
# "r2" selects Cloudflare R2 via its S3-compatible API — an explicit operator
# decision, never enabled by default. All downloads keep flowing through the
# authenticated GET /api/upload/:documentId route; the bucket stays private.
STORAGE_DRIVER=local
STORAGE_ROOT=storage/uploads

# --- Cloudflare R2 (only read when STORAGE_DRIVER=r2) -----------------------
# Create a PRIVATE bucket in the Cloudflare dashboard (R2 → Create bucket) and
# an S3 API token scoped to it (R2 → Manage R2 API Tokens → Create API token,
# Object Read & Write permission, bucket-scoped — least privilege). Put the
# real values in backend/.env or the hosting platform, NEVER here.
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT=""     # optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_REGION="auto"   # optional — "auto" is the region R2 documents for its S3 API
