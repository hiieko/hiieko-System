# Backend Environment Configuration

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hiieko_solar?schema=public"

# JWT Configuration
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# PaddleOCR Service Configuration
PADDLEOCR_URL="http://localhost:8080"
PADDLEOCR_TOKEN="change-this-token-in-production"
PADDLEOCR_TIMEOUT=60000

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:19006"

# File Upload Limits
MAX_FILE_SIZE=10485760

# Blob Storage (ISSUE-013 — receipt/document binaries; abstracted via StorageService)
# "local" writes under STORAGE_ROOT on the server; production can add an S3
# driver without changing domain code.
STORAGE_DRIVER=local
STORAGE_ROOT=storage/uploads
