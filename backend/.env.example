# Backend Environment Configuration

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hiieko_solar?schema=public"

# JWT Configuration
# REQUIRED (SEC-002) — the backend refuses to start when this is unset; there is no hardcoded
# fallback. Use a long, random value in every environment.
JWT_SECRET=""
# Slice 1 keeps the current 7-day access-token baseline. The 15-minute TTL and refresh tokens
# are introduced in Slice 2.
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# Company day boundary (Slice 3)
# Canonical IANA timezone for every business calendar day ("today"): attendance
# check-in/check-out, attendance today-summary, daily-plan defaults and the
# date-only @db.Date encodings. Blank/missing falls back to Europe/Bucharest.
COMPANY_TZ="Europe/Bucharest"

# PaddleOCR Service Configuration
PADDLEOCR_URL="http://localhost:8001"
PADDLEOCR_TOKEN="change-this-token-in-production"
PADDLEOCR_TIMEOUT=60000

# Demo mode (public GET /api/demo/accounts)
# The endpoint is inert when NODE_ENV=production unless this is set to "true". It only
# reports which seeded demo accounts exist and have data — never passwords.
DEMO_MODE="false"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:19006"
# For LAN development (phone/tablet on same Wi-Fi):
# CORS_ORIGIN=http://localhost:3000,http://localhost:19006,http://<YOUR_LAN_IP>:3000

# File Upload Limits
MAX_FILE_SIZE=10485760

# Email (Phase 3 Piece 1 — password reset; provider: Resend)
# RESEND_API_KEY="re_..."              # add your real key in backend/.env, NOT here
RESEND_FROM="HIIEKO <noreply@hiieko.app>"
# Public origin used to build the reset link. In production this is the Netlify URL.
PUBLIC_APP_URL="http://localhost:3000"

# Blob Storage (ISSUE-013 — receipt/document binaries; abstracted via StorageService)
# "local" writes under STORAGE_ROOT on the server; production can add an S3
# driver without changing domain code.
STORAGE_DRIVER=local
STORAGE_ROOT=storage/uploads
