# ====================================================================
# HIIEKO System — root .gitignore
# ====================================================================

# ---- Dependencies -------------------------------------------------
node_modules/

# ---- Build outputs ------------------------------------------------
.next/
out/
dist/
build/
web-build/
.expo/
*.tsbuildinfo

# ---- Environment / secrets ----------------------------------------
.env
.env.local
.env.*.local

# Per-project .env files (ignore, but keep .env.example templates)
web/.env
web/.env.local
Mobile/.env
Mobile/.env.local

# Keep example templates (DO NOT IGNORE THESE)
!.env.example
!web/.env.example
!Mobile/.env.example
!docs/AI_INSTRUCTIONS.md

# ---- Logs / OS / editor -------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Python / venv ------------------------------------------------
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---- Temporary / extraction files ---------------------------------
spec.txt
spec_extract.txt
spec_full.txt
spec_text.txt
check-db.js
setup-db.js
backend/test-web-api-flow.js

# ---- Uploaded blob storage (ISSUE-013) ------------------------------
backend/storage/

# ---- Test / coverage caches ----------------------------------------
coverage/
coverage.xml
.pytest_cache/
**/.pytest_cache/
htmlcov/
.coverage

# ---- Local scratch / temp ------------------------------------------
*.tmp
_*.txt

# ---- Cline / AI tools ---------------------------------------------
.clinerules/

# ---- Local verification artifacts (NOT source) ----------------------
# These are disposable: every headless-Chrome gate re-creates them.
# Root-anchored (leading "/") so application source can never match.
#
# CDP browser profiles written by the gates (.cdp-chrome-profile,
# .cdp-lan-profile, .cdp-p431-profile, .cdp-seed-profile,
# .cdp-issue048-profile, .cdp-p44-profile, ...)
/.cdp-*/
# Gate screenshots
/task-screenshots/
/planning-screenshots/
# Gate harnesses (browser / CDP checks)
/gate-*.js
/gate-*.out.json
/cdp-*.js
/quick-test.js
/final-test.js
/verify-parity.js
# Gate evidence, typecheck and test logs written to the repo root
/ot-*.js
/ot-*.ps1
/ot-*.cmd
/ot-*.done
/ot-*.txt
/ot-*.json
/ot-*.out
/ot-*.ts
/ot-*.tsx
/tsc-*.txt
/web-tsc.txt
/shared-tsc.txt
/jest-*.txt
/dbverify*.txt
/web/tsc_*.txt

opencode-*-progress.log
temp_*.txt
