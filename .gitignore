# ====================================================================
# HIIEKO System — root .gitignore
# ====================================================================

# ---- Dependencies -------------------------------------------------
node_modules/

# ---- Build outputs ------------------------------------------------
.next/
out/
dist/
build/
web-build/
.expo/
*.tsbuildinfo

# ---- Environment / secrets ----------------------------------------
.env
.env.local
.env.*.local

# Per-project .env files (ignore, but keep .env.example templates)
web/.env
web/.env.local
Mobile/.env
Mobile/.env.local

# Keep example templates (DO NOT IGNORE THESE)
!.env.example
!web/.env.example
!Mobile/.env.example
!docs/AI_INSTRUCTIONS.md

# ---- Supabase local tooling ---------------------------------------
supabase/.temp/
supabase/seed/.gitkeep

# ---- Logs / OS / editor -------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Python / venv ------------------------------------------------
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# ---- Temporary / extraction files ---------------------------------
spec.txt
spec_extract.txt
spec_full.txt
spec_text.txt
check-db.js
setup-db.js
backend/test-web-api-flow.js

# ---- Cline / AI tools ---------------------------------------------
.clinerules/
