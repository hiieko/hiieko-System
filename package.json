{
  "name": "solar-site-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "mobile",
    "backend"
  ],
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.6.1",
    "pg": "^8.23.0",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=web && npm run build --workspace=backend",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=web && npm run typecheck --workspace=mobile && npm run typecheck --workspace=backend",
    "test": "npm run test --workspace=backend",
    "web:dev": "npm run dev --workspace=web",
    "mobile:start": "npm run start --workspace=mobile",
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:test": "npm run test --workspace=backend",
    "db:migrate": "node database/scripts/run_migration.ts",
    "db:rollback": "node database/scripts/run_migration.ts --rollback",
    "db:verify": "node database/scripts/verify_migration.ts"
  }
}
